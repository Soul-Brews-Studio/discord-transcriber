# Dedicated BOT token only. Never a Discord user account token.
DISCORD_BOT_TOKEN=
# Optional: explicitly set to enable the transcription checkbox.
# Existing recovered MLX server accepts audio/wav POST /transcribe.
MLX_STT_URL=http://127.0.0.1:4655
PORT=4666
# Discord user id the "Follow me" action watches. Empty = following disabled.
FOLLOW_USER_ID=
